    "test": "node build.mjs && node --test test/e2e.test.mjs"
  },
  "devDependencies": {
    "@google/clasp": "^2.4.2",
    "@types/google-apps-script": "^1.0.83",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  }
}
