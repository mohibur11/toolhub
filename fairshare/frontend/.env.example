# Copy to .env.local and fill in (only for "npm run dev"; the deployed app reads js/fairshare-config.js).
# OAuth 2.0 Web client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Browser API key for Google's file picker (restricted to your sites)
VITE_GOOGLE_API_KEY=AIza...
