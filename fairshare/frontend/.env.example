# Copy to .env.local and fill in.
# OAuth 2.0 Web client ID from Google Cloud Console
VITE_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Apps Script web app URL (Deploy -> Manage deployments -> Web app URL, ends with /exec)
VITE_API_URL=https://script.google.com/macros/s/XXXXXXXX/exec
