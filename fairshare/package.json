{
  "name": "fairshare",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm -w frontend run dev",
    "build": "npm -w frontend run build",
    "build:backend": "npm -w backend run build",
    "push:backend": "npm -w backend run push",
    "test:backend": "npm -w backend test",
    "typecheck": "npm -w frontend run typecheck && npm -w backend run typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "type": "module"
}
